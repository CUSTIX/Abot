# Copy to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Manila
# Vite dev server origin, trusted for CSRF in development.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

POSTGRES_DB=abot
POSTGRES_USER=abot
POSTGRES_PASSWORD=abot-dev-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Password for the seeded demo user ("demo").
DEMO_PASSWORD=abot-demo

# --- Hosting only (see docs/deploy.md) ---
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DJANGO_HTTPS=true
# DEMO_MODE=true
